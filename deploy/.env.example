SECRET_KEY=replace-with-long-random
SECRETS_FERNET_KEY=replace-with-fernet-key
POSTGRES_PASSWORD=replace-with-db-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-me
HANDOFF_HOST_DIR=/mnt/backups/craig/handoff

# Client-side Kanka API pacing (CE default server limit is 30/min)
KANKA_MAX_REQUESTS_PER_MINUTE=24

# Optional OIDC
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://192.168.1.17:8095/api/v1/auth/oidc/callback
