SECRET_KEY=replace-with-long-random
SECRETS_FERNET_KEY=replace-with-fernet-key
POSTGRES_PASSWORD=replace-with-db-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-me

# Host paths / publish port (compose)
APP_PORT=8095
APP_BUILD_CONTEXT=..
POSTGRES_DATA_DIR=./data/postgres
HANDOFF_HOST_DIR=./data/handoff

# UI defaults (optional)
DEFAULT_KANKA_PUBLIC_URL=https://kanka.example
DEFAULT_LLM_BASE_URL_PLACEHOLDER=http://localhost:11434/v1

# Client-side Kanka API pacing (CE default server limit is 30/min)
KANKA_MAX_REQUESTS_PER_MINUTE=24

# Optional OIDC
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8095/api/v1/auth/oidc/callback
